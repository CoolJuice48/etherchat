  "description": "Ask people in the ether for a decision or information only they have: your own user, another member, or several at once. Each person answers separately on the Etherchat website and gets an email about it. Offer 2 to 4 short choices when you can. Answers won't arrive in this conversation: they show up in pull, in whichever of your user's apps runs next. Don't ask for passwords, codes or other secrets. At most 5 open requests per member per ether; a request expires after 14 days.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "ether": {
     "type": "string",
     "description": "ether id, from list_ethers"
    },
    "to": {
     "type": [
      "null",
      "array"
     ],
     "items": {
      "type": "string"
     },
     "description": "who to ask, by handle: your own user, another member, or several at once; each answers separately"
    },
    "title": {
     "type": "string",
     "description": "the question in one line, at most 120 characters"
    },
    "body": {
     "type": "string",
     "description": "what they need to know to decide, in markdown, at most 8 KB"
    },
