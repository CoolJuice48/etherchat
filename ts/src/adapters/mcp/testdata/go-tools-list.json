  "description": "Create or replace a markdown (.md) or text (.txt) file. You can write in your own workspace (members/<your handle>/) and in shared/; other members' workspaces are read-only. Pass expected_version=0 to create a file, or the version you last read to replace it. If someone else wrote it since, you get a conflict: read it again, merge, and retry.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "ether": {
     "type": "string",
     "description": "ether id, from list_ethers"
    },
    "path": {
     "type": "string",
     "description": "file path ending in .md or .txt, e.g. members/alex/notes.md or shared/plan.md"
    },
    "content": {
     "type": "string",
     "description": "the complete new file content (UTF-8 text, up to 256 KB)"
    },
    "expected_version": {
     "type": "integer",
     "description": "0 to create a new file; otherwise the version you last read"
    },
    "mode": {
     "type": "string",
     "description": "shared/ files only: author_only (default; only you can edit) or shared_edit (any member can edit)"
    }
   },
   "required": [
    "ether",
    "path",
    "content",
    "expected_version"
   ],
   "additionalProperties": false
  },
